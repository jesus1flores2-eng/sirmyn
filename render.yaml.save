services:
  - type: web
    name: sirmyn
    env: python
    buildCommand: |
      echo "============================================="
      echo "🚀 INICIANDO BUILD DE SIRMYN"
      echo "============================================="
      echo "📂 Directorio actual: $(pwd)"
      echo "📂 Archivos: $(ls -la)"
      echo "============================================="
      pip install -r requirements.txt
      echo "✅ Dependencias instaladas"
      echo "============================================="
      echo "🔄 Creando tablas en la base de datos..."
      python -c "from app import create_app; app = create_app(); app.app_context().push(); from app.extensions import db; db.create_all()"
      echo "✅ Tablas creadas correctamente"
      echo "============================================="
      echo "📥 Cargando datos de ejemplo..."
      python cargar_datos_municipio.py
      echo "✅ Datos cargados correctamente"
      echo "============================================="
    startCommand: gunicorn run:app
    envVars:
      - key: DATABASE_URL
        value: postgresql://postgres:Sirmyn2024!@db.nvcmhqgxeustddzqnyrl.supabase.co:5432/postgres
